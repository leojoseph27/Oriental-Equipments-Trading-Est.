---
// QuoteForm — accessible enquiry form. Submission goes through a small adapter
// (src/scripts/quote.ts); the current transport is the documented mailto fallback
// until a production provider is approved. No external service is contacted.
import { categories } from "../data/catalog";
---
<form id="quote-form" class="qf" novalidate>
  <div id="qf-summary" class="qf-summary" role="alert" tabindex="-1" hidden></div>

  <div class="qf-grid">
    <div class="field">
      <label for="qf-name">Full name <span class="req">required</span></label>
      <input id="qf-name" name="name" type="text" required maxlength="100" autocomplete="name" />
      <p class="err" id="qf-name-err" hidden></p>
    </div>
    <div class="field">
      <label for="qf-company">Company name <span class="opt">optional</span></label>
      <input id="qf-company" name="company" type="text" maxlength="100" autocomplete="organization" />
      <p class="err" id="qf-company-err" hidden></p>
    </div>
    <div class="field">
      <label for="qf-email">Email address <span class="req">required</span></label>
      <input id="qf-email" name="email" type="email" required maxlength="120" autocomplete="email"
        aria-describedby="qf-email-hint" />
      <p class="hint" id="qf-email-hint">We reply to this address.</p>
      <p class="err" id="qf-email-err" hidden></p>
    </div>
    <div class="field">
      <label for="qf-phone">Phone number <span class="opt">optional</span></label>
      <input id="qf-phone" name="phone" type="tel" maxlength="30" autocomplete="tel" />
      <p class="err" id="qf-phone-err" hidden></p>
    </div>
    <div class="field">
      <label for="qf-category">Product category <span class="opt">optional</span></label>
      <select id="qf-category" name="category">
        <option value="">— Select a category —</option>
        {categories.map((c) => <option value={c.name}>{c.name}</option>)}
      </select>
      <p class="err" id="qf-category-err" hidden></p>
    </div>
    <div class="field">
      <label for="qf-product">Product / model of interest <span class="opt">optional</span></label>
      <input id="qf-product" name="product" type="text" maxlength="150"
        aria-describedby="qf-product-hint" />
      <p class="hint" id="qf-product-hint">e.g. “MILD STEEL WELDING ELECTRODE, AWS E7018”. Links in the catalogue fill this automatically.</p>
      <p class="err" id="qf-product-err" hidden></p>
    </div>
    <div class="field">
      <label for="qf-quantity">Quantity / requested amount <span class="opt">optional</span></label>
      <input id="qf-quantity" name="quantity" type="text" maxlength="60" />
      <p class="err" id="qf-quantity-err" hidden></p>
    </div>
    <div class="field wide">
      <label for="qf-message">Enquiry message <span class="req">required</span></label>
      <textarea id="qf-message" name="message" required maxlength="2000" rows="6"
        aria-describedby="qf-message-hint"></textarea>
      <p class="hint" id="qf-message-hint">Include sizes, grades or any technical requirements (max 2000 characters).</p>
      <p class="err" id="qf-message-err" hidden></p>
    </div>
  </div>

  <button type="submit" class="qf-submit">Open Email Draft</button>
  <p class="qf-note">
    This form opens a pre-filled email in your own email application, addressed to
    orientaltradest@gmail.com — you review and send it yourself. The website cannot
    confirm on its own that an email was sent or received. If you prefer, email us
    directly at <a href="mailto:orientaltradest@gmail.com">orientaltradest@gmail.com</a>.
  </p>
  <div id="qf-status" class="qf-status" role="status" aria-live="polite" hidden></div>
  <div id="qf-copywrap" hidden>
    <p class="hint">Your enquiry text is long for an automatic email draft. Please copy it into a
    new email to <a href="mailto:orientaltradest@gmail.com">orientaltradest@gmail.com</a>:</p>
    <textarea id="qf-copy" rows="10" readonly aria-label="Enquiry text to copy"></textarea>
  </div>
</form>
<style>
  .qf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4) var(--space-5); }
  .field { display: flex; flex-direction: column; gap: var(--space-1); }
  .field.wide { grid-column: 1 / -1; }
  label { font-weight: 600; font-size: 15px; }
  .req { font-family: var(--font-mono); font-size: 11px; color: var(--red-brand); margin-left: var(--space-1); }
  .opt { font-family: var(--font-mono); font-size: 11px; color: var(--ink-tertiary); margin-left: var(--space-1); }
  input, select, textarea { font: inherit; padding: 10px 12px; border: var(--line-weight) solid var(--line);
    background: var(--paper-card); color: var(--ink); border-radius: var(--radius); width: 100%;
    transition: border-color var(--dur-fast) var(--ease-standard); }
  input:hover:not([aria-invalid="true"]), select:hover, textarea:hover:not([aria-invalid="true"]) { border-color: var(--ink-tertiary); }
  input[aria-invalid="true"], select[aria-invalid="true"], textarea[aria-invalid="true"] {
    border-color: var(--red-brand); border-width: 2px; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .hint { font-family: var(--font-mono); font-size: 12px; color: var(--ink-tertiary); margin: 0; }
  .err { font-size: 14px; color: var(--red-deep); font-weight: 500; margin: 0; }
  .err::before { content: "⚠ "; }
  .qf-summary { border: 2px solid var(--red-brand); background: #fff; padding: var(--space-4);
    margin-bottom: var(--space-5); }
  .qf-summary p { margin: 0 0 var(--space-2); font-weight: 600; }
  .qf-summary ul { margin: 0; padding-left: var(--space-5); }
  .qf-submit { font: inherit; font-weight: 600; background: var(--red-brand); color: #fff;
    border: none; border-radius: var(--radius); padding: 12px 26px; cursor: pointer; margin-top: var(--space-5);
    transition: background-color var(--dur-fast) var(--ease-standard); }
  .qf-submit:hover { background: var(--red-deep); }
  .qf-submit:focus-visible, a:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .qf-note { font-family: var(--font-mono); font-size: 12px; color: var(--ink-secondary);
    margin-top: var(--space-4); max-width: 70ch; }
  @media (prefers-reduced-motion: no-preference) {
    .qf-status:not([hidden]), #qf-copywrap:not([hidden]) { animation: qf-in var(--dur-med) var(--ease-out); }
  }
  @keyframes qf-in {
    from { opacity: 0; transform: translateY(var(--dist-1)); }
    to { opacity: 1; transform: none; }
  }
  .qf-status { border: var(--line-weight) solid var(--green-brand); background: #fff;
    border-left: 4px solid var(--green-brand); padding: var(--space-4); margin-top: var(--space-4);
    max-width: 70ch; }
  #qf-copywrap { margin-top: var(--space-4); max-width: 70ch; }
  #qf-copy { width: 100%; font-family: var(--font-mono); font-size: 13px; }
  @media (max-width: 700px) { .qf-grid { grid-template-columns: 1fr; } }
</style>
<script src="../scripts/quote.ts"></script>
