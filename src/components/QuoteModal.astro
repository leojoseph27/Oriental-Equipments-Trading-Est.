---
// QuoteModal — one shared quote dialog for every product "Request a Quote"
// button. Buttons carry data-quote-* attributes (see ProductCard); the script
// reads them on every open, so the dialog never shows a previous product.
// Their href (/contact/?product=…) stays as the no-JavaScript fallback.
// Submission uses the documented mailto adapter (src/scripts/enquiry.ts).
---
<dialog id="quote-modal" class="qm" aria-labelledby="qm-title" aria-describedby="qm-intro">
  <form id="qm-form" class="qm-form" novalidate>
    <button type="button" class="qm-close" aria-label="Close quote request">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <h2 id="qm-title" class="qm-title">Let's Discuss Your Requirement</h2>
    <p id="qm-intro" class="qm-intro">Fill in the details below and our sales team will contact you shortly.</p>

    <div class="qm-grid">
      <div class="qm-field">
        <label for="qm-name">Name <span class="qm-req" aria-hidden="true">*</span></label>
        <input id="qm-name" name="name" type="text" required maxlength="100" autocomplete="name" />
        <p class="qm-err" id="qm-name-err" hidden></p>
      </div>
      <div class="qm-field">
        <label for="qm-email">Email <span class="qm-req" aria-hidden="true">*</span></label>
        <input id="qm-email" name="email" type="email" required maxlength="120" autocomplete="email" />
        <p class="qm-err" id="qm-email-err" hidden></p>
      </div>
      <div class="qm-field">
        <label for="qm-phone">Mobile Number <span class="qm-req" aria-hidden="true">*</span></label>
        <input id="qm-phone" name="phone" type="tel" required maxlength="30" autocomplete="tel" inputmode="tel" />
        <p class="qm-err" id="qm-phone-err" hidden></p>
      </div>
      <div class="qm-field">
        <label for="qm-company">Company Name <span class="qm-req" aria-hidden="true">*</span></label>
        <input id="qm-company" name="company" type="text" required maxlength="100" autocomplete="organization" />
        <p class="qm-err" id="qm-company-err" hidden></p>
      </div>
      <div class="qm-field wide">
        <label for="qm-product">Product</label>
        <input id="qm-product" name="product" type="text" readonly aria-readonly="true" tabindex="-1" />
      </div>
      <div class="qm-field wide">
        <label for="qm-message">Your Requirement <span class="qm-opt">(optional)</span></label>
        <textarea id="qm-message" name="message" rows="4" maxlength="2000"
          placeholder="Quantity, sizes, grades or any technical requirements"></textarea>
      </div>
    </div>

    <button type="submit" class="qm-submit">Send Enquiry</button>
    <div id="qm-status" class="qm-status" role="status" aria-live="polite" hidden></div>
    <textarea id="qm-copy" class="qm-copy" rows="8" readonly aria-label="Enquiry text to copy" hidden></textarea>
  </form>
</dialog>
<style>
  .qm { width: min(560px, calc(100vw - 24px)); max-width: none; max-height: calc(100dvh - 24px);
    padding: 0; border: none; border-radius: 16px; background: #fff; color: var(--ink);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28); overflow: auto; overscroll-behavior: contain; }
  .qm::backdrop { background: rgba(17, 17, 17, 0.6); }
  .qm-form { position: relative; padding: 32px 32px 28px; }
  .qm-close { position: absolute; top: 12px; right: 12px; width: 44px; height: 44px;
    display: grid; place-items: center; border: none; border-radius: 50%; background: transparent;
    color: var(--ink); cursor: pointer; transition: background-color var(--dur-fast) var(--ease-standard); }
  .qm-close:hover { background: var(--paper); }
  .qm-title { margin: 0 44px 6px 0; font-family: var(--font-heading); font-size: 24px; line-height: 1.2; }
  .qm-intro { margin: 0 0 20px; color: var(--ink-secondary); font-size: 15px; }
  .qm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .qm-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .qm-field.wide { grid-column: 1 / -1; }
  .qm label { font-weight: 600; font-size: 14px; }
  .qm-req { color: var(--red-brand); }
  .qm-opt { font-weight: 400; color: var(--ink-tertiary); }
  .qm input, .qm textarea { font: inherit; font-size: 16px; width: 100%; min-height: 44px; padding: 10px 12px;
    border: 1px solid var(--line); border-radius: var(--radius-input); background: #fff; color: var(--ink); }
  .qm textarea { resize: vertical; }
  .qm input[readonly] { background: var(--paper); font-weight: 600; }
  .qm input[aria-invalid="true"] { border: 2px solid var(--red-brand); }
  .qm input:focus-visible, .qm textarea:focus-visible, .qm button:focus-visible {
    outline: 2px solid var(--ink); outline-offset: 2px; }
  .qm-err { margin: 0; font-size: 13px; color: var(--red-deep); font-weight: 500; }
  .qm-submit { margin-top: 20px; width: 100%; min-height: 48px; border: none; border-radius: var(--radius-pill);
    background: var(--red-brand); color: #fff; font: inherit; font-weight: 600; font-size: 16px; cursor: pointer;
    box-shadow: var(--shadow-btn); transition: background-color var(--dur-ui) var(--ease-standard); }
  .qm-submit:hover { background: var(--red-deep); }
  .qm-submit:disabled { opacity: 0.65; cursor: progress; }
  .qm-status { margin-top: 14px; padding: 12px 14px; border-radius: var(--radius-sm); font-size: 14px;
    border-left: 4px solid var(--green-brand); background: #f3f8f4; }
  .qm-status[data-tone="error"] { border-left-color: var(--red-brand); background: #fdf3f3; }
  .qm-copy { margin-top: 10px; font-family: var(--font-mono); font-size: 13px; }
  :global(html.qm-lock) { overflow: hidden; }
  @media (max-width: 560px) {
    .qm { width: calc(100vw - 16px); max-height: calc(100dvh - 16px); border-radius: 14px; }
    .qm-form { padding: 24px 18px 20px; }
    .qm-title { font-size: 20px; }
    .qm-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .qm[open] { animation: qm-in 200ms var(--ease-out); }
  }
  @keyframes qm-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
</style>
<script>
  import { sendEnquiry, COMPANY_EMAIL } from '../scripts/enquiry';

  const dialog = document.getElementById('quote-modal') as HTMLDialogElement | null;
  const form = document.getElementById('qm-form') as HTMLFormElement | null;
  if (dialog && form && typeof dialog.showModal === 'function') {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const product = $<HTMLInputElement>('qm-product');
    const message = $<HTMLTextAreaElement>('qm-message');
    const status = $<HTMLDivElement>('qm-status');
    const copy = $<HTMLTextAreaElement>('qm-copy');
    const submit = form.querySelector<HTMLButtonElement>('.qm-submit')!;
    const required = ['name', 'email', 'phone', 'company'] as const;
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    let current = { id: '', name: '', code: '', category: '' };
    let busy = false;
    let opener: HTMLElement | null = null;
    let savedY = 0;

    const input = (id: string) => $<HTMLInputElement>(`qm-${id}`);
    function check(id: (typeof required)[number]): string {
      const v = input(id).value.trim();
      if (id === 'name') return v ? '' : 'Enter your name.';
      if (id === 'email') return !v ? 'Enter your email address.' : EMAIL_RE.test(v) ? '' : 'Enter a valid email address, e.g. name@company.com.';
      if (id === 'phone') return !v ? 'Enter your mobile number.' : /^[+\d ()\-.]{6,30}$/.test(v) ? '' : 'Enter a valid mobile number (digits, spaces, + ( ) - only).';
      return v ? '' : 'Enter your company name.';
    }
    function show(id: (typeof required)[number], msg: string) {
      const el = input(id), err = $(`qm-${id}-err`);
      err.textContent = msg; err.hidden = !msg;
      if (msg) { el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', err.id); }
      else { el.removeAttribute('aria-invalid'); el.removeAttribute('aria-describedby'); }
    }
    for (const id of required) {
      input(id).addEventListener('input', () => { if (input(id).getAttribute('aria-invalid')) show(id, check(id)); });
      input(id).addEventListener('blur', () => { if (input(id).value.trim()) show(id, check(id)); });
    }

    function setStatus(text: string, tone: 'ok' | 'error' = 'ok') {
      status.textContent = text; status.dataset.tone = tone; status.hidden = !text;
    }

    function open(btn: HTMLElement) {
      const d = btn.dataset;
      current = { id: d.quoteId || '', name: d.quoteName || '', code: d.quoteCode || '', category: d.quoteCategory || '' };
      product.value = current.code ? `${current.name} (${current.code})` : current.name;
      // Per-product state is reset on every open; contact details are kept for convenience.
      message.value = '';
      setStatus('');
      copy.hidden = true; copy.value = '';
      for (const id of required) show(id, '');
      busy = false; submit.disabled = false; submit.removeAttribute('aria-busy');
      opener = btn;
      savedY = window.scrollY;
      document.documentElement.classList.add('qm-lock');
      dialog!.showModal();
      input('name').focus({ preventScroll: true });
      // Some engines (Safari) move the page when overflow is locked; pin it back.
      if (window.scrollY !== savedY) window.scrollTo(0, savedY);
    }
    function close() { if (!busy) dialog!.close(); }

    document.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-quote-id]');
      if (!btn || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open(btn);
    });
    dialog.querySelector('.qm-close')!.addEventListener('click', close);
    dialog.addEventListener('cancel', (e) => { if (busy) e.preventDefault(); });
    // Clicks on the dialog element itself (not its form) land on the backdrop.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('qm-lock');
      if (window.scrollY !== savedY) window.scrollTo(0, savedY);
      opener?.focus({ preventScroll: true });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (busy) return;
      let first: HTMLInputElement | null = null;
      for (const id of required) {
        const msg = check(id); show(id, msg);
        if (msg && !first) first = input(id);
      }
      if (first) { setStatus('Please complete the required fields highlighted above.', 'error'); first.focus(); return; }

      busy = true; submit.disabled = true; submit.setAttribute('aria-busy', 'true');
      const v = (id: string) => input(id).value.trim();
      const label = product.value;
      try {
        const result = sendEnquiry(`Quote request — ${label || 'product enquiry'}`, [
          `Name: ${v('name')}`,
          `Email: ${v('email')}`,
          `Mobile: ${v('phone')}`,
          `Company: ${v('company')}`,
          `Product: ${current.name}`,
          current.code && `Product code: ${current.code}`,
          current.category && `Category: ${current.category}`,
          current.id && `Catalogue reference: ${current.id}`,
          `Page: ${location.href}`,
          '',
          'Requirement:',
          message.value.trim() || '(not specified)',
        ]);
        if (result.kind === 'mailto') {
          setStatus('Your email application should now open with this enquiry pre-filled. Please press send there to complete your request — the website cannot confirm delivery on its own.');
        } else {
          copy.value = result.body; copy.hidden = false;
          setStatus(`Your requirement is too long for an automatic email draft. Please copy the text below into a new email to ${COMPANY_EMAIL}.`);
        }
      } catch {
        setStatus(`Your email application could not be opened. Please email ${COMPANY_EMAIL} directly with your enquiry.`, 'error');
      } finally {
        // Brief lock so a double-click cannot open two drafts.
        setTimeout(() => { busy = false; submit.disabled = false; submit.removeAttribute('aria-busy'); }, 1500);
      }
    });
  }
</script>
