---
// ProductCard — one verified catalogue record. Shows only fields the record has.
// The card element carries the product id so search results can anchor to it.
import type { Product } from "../data/catalog";
interface Props { product: Product }
const { product: p } = Astro.props;
---
<article class="pc" id={p.id}>
  <div class="pc-media">
    {p.image ? (
      <img src={p.image} alt={p.name} loading="lazy" width="440" height="320" />
    ) : (
      <div class="pc-noimg" aria-hidden="true"></div>
    )}
  </div>
  <div class="pc-body">
    <h2 class="pc-name">{p.name}</h2>
    <dl class="spec">
      {p.awsNo && <div><dt>AWS NO</dt><dd>{p.awsNo}</dd></div>}
      {p.model && <div><dt>MODEL</dt><dd>{p.model}</dd></div>}
      {p.amps && <div><dt>AMPS</dt><dd>{p.amps}</dd></div>}
      {p.sizes && <div><dt>SIZES</dt><dd>{p.sizes}</dd></div>}
      {p.packet && <div><dt>PACKET</dt><dd>{p.packet}</dd></div>}
      {p.notes && <div><dt>NOTES</dt><dd>{p.notes}</dd></div>}
    </dl>
    <div class="pc-foot">
      <a class="enq" href={`/contact/?product=${encodeURIComponent(p.id)}`}
        aria-label={`Request a quote for ${p.name}`}>Request a Quote</a>
    </div>
  </div>
</article>
<style>
  .pc { background: var(--paper-card); border: var(--line-weight) solid var(--line);
    display: flex; flex-direction: column; scroll-margin-top: 96px; overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-standard), box-shadow var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard); }
  @media (prefers-reduced-motion: no-preference) {
    .pc:hover { transform: translateY(-2px); box-shadow: var(--shadow-2); border-color: var(--ink-tertiary); }
  }
  .pc:target { border-color: var(--red-brand); box-shadow: inset 0 0 0 1px var(--red-brand); }
  .pc-media { height: 280px; display: flex; align-items: center; justify-content: center;
    background: #fff; border-bottom: var(--line-weight) solid var(--line); overflow: hidden; }
  .pc img { width: 100%; height: 100%; object-fit: contain;
    transition: transform 280ms var(--ease-standard); }
  @media (prefers-reduced-motion: no-preference) {
    .pc:hover img { transform: scale(1.03); }
  }
  .pc-noimg { width: 100%; height: 100%; background: var(--paper); }
  @media (max-width: 1000px) { .pc-media { height: 240px; } }
  @media (max-width: 620px) { .pc-media { height: 200px; } }
  .pc-body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  h2 { margin: 0; font-size: 18px; line-height: 1.2; text-transform: uppercase; }
  dl { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  dl div { display: flex; gap: var(--space-2); }
  dt { font-family: var(--font-mono); font-size: 12px; color: var(--green-brand);
    flex: none; width: 64px; text-transform: uppercase; padding-top: 1px; }
  dd { margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--ink-secondary); }
  .pc-foot { margin-top: auto; display: flex; justify-content: flex-end; align-items: center;
    gap: var(--space-2); padding-top: var(--space-2); flex-wrap: wrap; }
  .enq { font-family: var(--font-mono); font-size: 12px; color: var(--red-brand);
    text-decoration: none; border: var(--line-weight) solid var(--line); border-radius: var(--radius);
    padding: 8px 12px; }
  .enq:hover { border-color: var(--red-brand); }
</style>
