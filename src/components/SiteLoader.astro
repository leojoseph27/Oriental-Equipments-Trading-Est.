---
// SiteLoader — first-visit / reload intro using the company logo image on a
// #fcfcfc full-screen overlay. One CSS zoom animation for both breakpoints:
// desktop ends at ~50% of the viewport width, mobile (≤767px) keeps its
// existing dramatic zoom. The overlay fades away within the animation's
// final beat and is removed on its own `animationend`, so the site appears
// with no gap. A single failsafe timer guarantees the page can never stay
// blocked. Hidden entirely without JavaScript; sessionStorage plays it once
// per session while an explicit reload (Ctrl+Shift+R) always replays it
// (PLAY_ON_RELOAD); reduced-motion users get a short plain fade.
const LOGO = '/images/logo/oriental-logo.png';
// Build-day stamp: each deployment gets a fresh sessionStorage key, so a flag
// written by an older loader version (or an older deployment) can never
// suppress the new intro. iOS Safari keeps tab sessionStorage alive for days,
// which previously made the intro appear to be "missing" on iPhone.
const BUILD_DAY = new Date().toISOString().slice(0, 10);
// A stored visit older than this counts as a new session and replays the
// intro, because iOS restores tabs (with sessionStorage) days later.
const SESSION_TTL_MS = 12 * 60 * 60 * 1000;
const INTRO_KEY = `oriental-intro-shown:${BUILD_DAY}`;
---
<div id="site-loader" class="site-loader" role="presentation" aria-hidden="true">
  <img class="loader-logo" src={LOGO} alt="" width="260" height="239" decoding="async" fetchpriority="high" />
</div>
<style>
  /* Hidden unless <html> has .intro-active from the inline script below,
     so the page is fully accessible without JavaScript. */
  .site-loader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #fcfcfc;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  :global(html.intro-active) .site-loader {
    display: flex;
    pointer-events: auto;
  }
  .loader-logo {
    /* Desktop: starts at ~18% of the viewport width and zooms to ~50%. */
    width: 18vw;
    height: auto;
    object-fit: contain;
    opacity: 0;
    will-change: transform, opacity;
  }
  :global(html.intro-active:not(.intro-reduced)) .loader-logo {
    animation: loader-intro 4s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  :global(html.intro-active:not(.intro-reduced)) .site-loader {
    animation: loader-out 0.5s ease 3.5s forwards;
  }
  @keyframes loader-intro {
    0%   { opacity: 0; transform: scale(1); }
    12%  { opacity: 1; transform: scale(1); }
    80%  { opacity: 1; transform: scale(2.8); }
    100% { opacity: 1; transform: scale(2.8); }
  }
  @keyframes loader-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  /* Phones (≤767px): the existing dramatic zoom — starts small and keeps
     growing past the viewport edges over 5 seconds. */
  @media (max-width: 767px) {
    .loader-logo {
      width: min(38vmin, 300px);
      transform: scale(0.3);
    }
    :global(html.intro-active:not(.intro-reduced)) .loader-logo {
      animation: loader-intro-mobile 5s cubic-bezier(0.6, 0, 0.3, 1) forwards;
    }
    :global(html.intro-active:not(.intro-reduced)) .site-loader {
      animation: loader-out 0.6s ease 4.4s forwards;
    }
  }
  @keyframes loader-intro-mobile {
    0%   { opacity: 0; transform: scale(0.3); }
    10%  { opacity: 1; transform: scale(0.3); }
    84%  { opacity: 1; transform: scale(1.9); }
    92%  { opacity: 1; transform: scale(2.4); }
    100% { opacity: 0; transform: scale(2.8); }
  }
  /* Reduced motion: no zoom at all — brief plain fade. */
  :global(html.intro-active.intro-reduced) .site-loader {
    animation: loader-fade 1.3s ease forwards;
  }
  @keyframes loader-fade {
    0% { opacity: 1; }
    55% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
<script is:inline define:vars={{ INTRO_KEY, SESSION_TTL_MS }}>
  (function () {
    var loader = document.getElementById('site-loader');
    if (!loader) return;

    // Set to false before production if the intro should play only on the
    // first page view of a browser session. While true (default), an explicit
    // page reload — including Ctrl+Shift+R — always replays the intro;
    // ordinary link navigation between pages still plays it once per session.
    var PLAY_ON_RELOAD = true;

    var firstVisit = true;
    var isReload = false;
    try {
      var previous = parseInt(sessionStorage.getItem(INTRO_KEY), 10);
      // Play when there is no stamp for this deployment, when the stamp is
      // from a tab iOS restored after many hours, or on an explicit reload.
      firstVisit = !previous || Date.now() - previous > SESSION_TTL_MS;
      sessionStorage.setItem(INTRO_KEY, String(Date.now()));
      var nav = performance.getEntriesByType('navigation')[0];
      isReload = !!nav && nav.type === 'reload';
    } catch (e) { /* storage unavailable: show on this load only */ }
    if (!firstVisit && !(PLAY_ON_RELOAD && isReload)) return;

    var root = document.documentElement;
    var dismissed = false;

    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      root.classList.remove('intro-active', 'intro-reduced');
      loader.remove();
    }

    // iOS back/forward cache: a restored page must never reappear with the
    // overlay still covering it (or resume a half-finished animation).
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) dismiss();
    });

    // The overlay's own fade animation is the primary dismissal signal for
    // every mode; the timers below are backups only.
    loader.addEventListener('animationend', function (e) {
      if (e.animationName === 'loader-out' || e.animationName === 'loader-fade') dismiss();
    });
    setTimeout(dismiss, 8000);

    root.classList.add('intro-active');
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('intro-reduced');
    } catch (e) { /* treat as full motion */ }
  })();
</script>
