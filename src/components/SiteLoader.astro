---
// SiteLoader — first-visit / reload intro. Desktop (and tablets >767px)
// play the company logo intro video full-bleed; phones (≤767px) get the
// cinematic logo zoom animation instead (no video). Both sit on a #fcfcfc
// full-screen overlay and reveal the site exactly as the intro finishes.
// One safe lifecycle for both modes: an inline script marks the intro
// active once the media is ready, dismissal is anchored to the intro's own
// end (video `ended` / CSS `animationend`) with hard failsafe timers, so
// the page can never remain blocked. Hidden entirely without JavaScript;
// sessionStorage plays it once per session, while an explicit reload
// (Ctrl+Shift+R) always replays it while PLAY_ON_RELOAD is true.
// Reduced-motion users get a short plain fade in either mode.
const LOGO = '/images/logo/oriental-logo.png';
---
<div id="site-loader" class="site-loader" role="presentation" aria-hidden="true">
  <video class="loader-video" muted playsinline autoplay preload="auto"></video>
  <img class="loader-logo" src={LOGO} alt="" width="260" height="239" decoding="async" fetchpriority="high" />
</div>
<style>
  /* Hidden unless <html> has .intro-active from the inline script below,
     so the page is fully accessible without JavaScript. */
  .site-loader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #fcfcfc;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  :global(html.intro-active) .site-loader {
    display: flex;
    pointer-events: auto;
  }
  /* Desktop/tablet: full-bleed intro video. */
  .loader-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .loader-logo { display: none; }

  /* Phones (≤767px): cinematic logo zoom instead of the video. The logo
     fades in small, then one continuous zoom carries it past the viewport
     edges; the overlay fades away within the final second. */
  @media (max-width: 767px) {
    .loader-video { display: none; }
    .loader-logo {
      display: block;
      width: min(38vmin, 300px);
      height: auto;
      object-fit: contain;
      opacity: 0;
      transform: scale(0.3);
      will-change: transform, opacity;
    }
    :global(html.intro-active:not(.intro-reduced)) .loader-logo {
      animation: loader-intro 5s cubic-bezier(0.6, 0, 0.3, 1) forwards;
    }
    :global(html.intro-active:not(.intro-reduced)) .site-loader {
      animation: loader-out 0.6s ease 4.4s forwards;
    }
  }
  @keyframes loader-intro {
    0%   { opacity: 0; transform: scale(0.3); }
    10%  { opacity: 1; transform: scale(0.3); }
    84%  { opacity: 1; transform: scale(3.8); }
    92%  { opacity: 1; transform: scale(4.8); }
    100% { opacity: 0; transform: scale(5.6); }
  }
  @keyframes loader-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  /* Begin fading the overlay while the video is finishing its last beat, so
     the site is fully revealed exactly as the video ends — no gap. */
  :global(html.intro-ending) .site-loader {
    opacity: 0;
    transition: opacity 0.45s ease-out;
  }
  /* Reduced motion: no video, no zoom — brief plain fade. */
  :global(html.intro-active.intro-reduced) .site-loader {
    animation: loader-fade 1.3s ease forwards;
  }
  :global(html.intro-active.intro-reduced) .loader-logo,
  :global(html.intro-active.intro-reduced) .loader-video {
    display: none;
  }
  @keyframes loader-fade {
    0% { opacity: 1; }
    55% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
<script is:inline>
  (function () {
    var loader = document.getElementById('site-loader');
    if (!loader) return;

    // Set to false before production if the intro should play only on the
    // first page view of a browser session. While true (default), an explicit
    // page reload — including Ctrl+Shift+R — always replays the intro;
    // ordinary link navigation between pages still plays it once per session.
    var PLAY_ON_RELOAD = true;

    var firstVisit = true;
    var isReload = false;
    try {
      firstVisit = !sessionStorage.getItem('oriental-intro-shown');
      sessionStorage.setItem('oriental-intro-shown', '1');
      var nav = performance.getEntriesByType('navigation')[0];
      isReload = !!nav && nav.type === 'reload';
    } catch (e) { /* storage unavailable: show on this load only */ }
    if (!firstVisit && !(PLAY_ON_RELOAD && isReload)) return;

    var root = document.documentElement;
    var started = false;
    var dismissed = false;

    // Exactly one mode per load, decided up front so a mid-load resize
    // never swaps the intro or restarts playback. Phones get the logo
    // animation; everything larger plays the desktop video.
    var MOBILE_QUERY = '(max-width: 767px)';
    var isMobileViewport = false;
    try { isMobileViewport = matchMedia(MOBILE_QUERY).matches; } catch (e) {}
    var video = loader.querySelector('video');
    if (!isMobileViewport && video) {
      video.src = '/videos/oriental-intro.mp4';
    }

    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      root.classList.remove('intro-active', 'intro-ending', 'intro-reduced');
      loader.remove();
    }

    function begin() {
      if (started) return;
      started = true;
      var reduced = false;
      try { reduced = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      root.classList.add('intro-active');
      if (reduced) {
        root.classList.add('intro-reduced');
        loader.addEventListener('animationend', dismiss);
        return;
      }

      if (isMobileViewport) {
        // Logo mode: CSS plays the 5s zoom; the overlay fade completes at
        // 5.0s, so dismiss right after. The intro's own animationend is the
        // precise signal; the timer is the backup.
        loader.addEventListener('animationend', function (e) {
          if (e.animationName === 'loader-out') dismiss();
        });
        setTimeout(dismiss, 5600);
      } else {
        // Video mode: reveal the site within the video's final second,
        // remove the overlay exactly on end. A broken/stalled asset must
        // never block the page.
        if (!video || !video.src) { dismiss(); return; }
        video.addEventListener('timeupdate', function onTime() {
          var d = video.duration;
          if (d && video.currentTime >= d - 0.6) {
            video.removeEventListener('timeupdate', onTime);
            root.classList.add('intro-ending');
          }
        });
        video.addEventListener('ended', dismiss);
        video.addEventListener('error', dismiss);
        video.play().catch(function () { /* autoplay blocked → failsafe below */ });
      }
    }

    // Video mode: start only once the video can actually play; a cap keeps
    // a failed asset from delaying the intro indefinitely.
    if (!isMobileViewport) {
      var beginOnce = function () { begin(); };
      if (video && video.readyState < 3) {
        video.addEventListener('canplay', beginOnce, { once: true });
        video.addEventListener('error', beginOnce, { once: true });
        setTimeout(beginOnce, 4000);
      } else {
        beginOnce();
      }
    } else {
      begin();
    }

    // Hard failsafe: whatever happens, the overlay cannot outlive this.
    setTimeout(dismiss, 25000);
    window.addEventListener('load', function () {
      setTimeout(dismiss, 25000);
    }, { once: true });
  })();
</script>
