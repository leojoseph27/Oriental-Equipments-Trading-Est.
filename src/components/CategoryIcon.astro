---
// CategoryIcon — single central mapping of catalogue category slug → icon.
// Icons are inline SVGs on the Lucide 24×24 grid (stroke 2, round caps/joins):
// most are Lucide v1.63.0 (ISC), a few are custom where Lucide has no accurate
// equivalent (marked "custom"). Rendered decorative: aria-hidden, coloured by
// the tile context (green brand accent via .cat-icon color).
interface IconDef { name: string; source: "lucide" | "custom"; body: string; }

export const categoryIcons: Record<string, IconDef> = {
