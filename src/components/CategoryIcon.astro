  safety: {
    name: "shield-check", source: "lucide",
    body: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>`,
  },
  "hand-protections": {
    name: "hand", source: "lucide",
    body: `<path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>`,
  },
  "welding-protective-gear": {
    name: "shirt", source: "lucide",
    body: `<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>`,
  },
};

// Uniqueness guard: every icon name must be distinct — a duplicate would make
// two categories share a visual identity.
const names = Object.values(categoryIcons).map((i) => i.name);
const dupes = names.filter((n, i) => names.indexOf(n) !== i);
if (dupes.length > 0) {
  throw new Error(`CategoryIcon: duplicate icon names: ${[...new Set(dupes)].join(", ")}`);
}

const { slug } = Astro.props;
const icon = categoryIcons[slug];
if (!icon) throw new Error(`CategoryIcon: no icon mapped for slug "${slug}"`);
---
<svg
  class="cat-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
<style>
  .cat-icon { width: 30px; height: 30px; color: var(--green-brand); flex: none; }
  @media (max-width: 760px) { .cat-icon { width: 26px; height: 26px; } }
</style>
