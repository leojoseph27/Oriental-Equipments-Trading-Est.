const { icon } = Astro.props;
const def = featureIcons[icon];
if (!def) throw new Error(`FeatureIcon: no icon mapped for "${icon}"`);
---
<svg
  class="feature-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={def.body}
/>
<style>
  .feature-icon { width: 26px; height: 26px; color: var(--green-brand); flex: none; }
  @media (max-width: 560px) { .feature-icon { width: 22px; height: 22px; } }
</style>
