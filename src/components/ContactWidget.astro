---
// ContactWidget — global floating contact rail (phone / WhatsApp / email) with
// a collapsible "Get a Call Back" panel. Replaces the standalone WhatsApp
// button. WhatsApp destination, phone numbers and email are the existing
// company contacts; submission reuses the mailto adapter (src/scripts/enquiry.ts).
---
<div class="cw" id="contact-widget">
  <!-- Callback panel -->
  <div class="cw-panel" id="cw-panel" hidden>
    <div class="cw-panel-head">
      <span class="cw-panel-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </span>
      <div>
        <h2 id="cw-title">Get a Call Back</h2>
        <p>Share your details and our team will call you shortly.</p>
      </div>
      <button type="button" class="cw-close" id="cw-close" aria-label="Close the call back panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="cw-form" novalidate>
      <div class="cw-field">
        <label for="cw-name">Name <span aria-hidden="true">*</span></label>
        <input type="text" id="cw-name" name="name" autocomplete="name" required maxlength="120" />
        <p class="cw-err" id="cw-name-err" hidden></p>
      </div>
      <div class="cw-field">
        <label for="cw-phone">Phone number <span aria-hidden="true">*</span></label>
        <input type="tel" id="cw-phone" name="phone" autocomplete="tel" inputmode="tel" required maxlength="30" />
        <p class="cw-err" id="cw-phone-err" hidden></p>
      </div>
      <div class="cw-field">
        <label for="cw-email">Email <span aria-hidden="true">*</span></label>
        <input type="email" id="cw-email" name="email" autocomplete="email" required maxlength="200" />
        <p class="cw-err" id="cw-email-err" hidden></p>
      </div>
      <div class="cw-field">
        <label for="cw-message">Message <span class="cw-opt">(optional)</span></label>
        <textarea id="cw-message" name="message" rows="3" maxlength="1000"></textarea>
      </div>
      <div id="cw-status" role="status" hidden></div>
      <button type="submit" class="cw-submit" id="cw-submit">
        Submit Request
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </form>
  </div>

  <!-- Contact rail -->
  <nav class="cw-rail" aria-label="Contact options">
    <div class="cw-item">
      <button type="button" class="cw-btn cw-btn-phone" id="cw-phone-btn" aria-expanded="false" aria-controls="cw-fly-phone" aria-label="Call us or request a call back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </button>
      <div class="cw-fly" id="cw-fly-phone" role="menu" aria-label="Phone options">
        <a role="menuitem" href="tel:+966580208504">+966-58-020-8504 <span class="cw-fly-act">Call Now</span></a>
        <a role="menuitem" href="tel:+966594345166">+966-59-434-5166 <span class="cw-fly-act">Call Now</span></a>
        <button type="button" role="menuitem" id="cw-callback">Request a call back</button>
      </div>
    </div>

    <div class="cw-item">
      <button type="button" class="cw-btn cw-btn-wa" id="cw-wa-btn" aria-expanded="false" aria-controls="cw-fly-wa" aria-label="Chat with us on WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      </button>
      <div class="cw-fly" id="cw-fly-wa" role="menu" aria-label="WhatsApp option">
        <a role="menuitem" href="https://wa.me/966580208504" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      </div>
    </div>

    <div class="cw-item">
      <button type="button" class="cw-btn cw-btn-mail" id="cw-mail-btn" aria-expanded="false" aria-controls="cw-mail-panel" aria-haspopup="dialog" aria-label="Open the email enquiry form">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </button>
    </div>
  </nav>

  <!-- Email enquiry sheet (mobile: bottom sheet, desktop: floating panel) -->
  <div class="cw-backdrop" id="cw-mail-backdrop" hidden></div>
  <div class="cw-mail" id="cw-mail-panel" role="dialog" aria-modal="true" aria-labelledby="cw-mail-title" hidden>
    <div class="cw-mail-grip" aria-hidden="true"></div>
    <div class="cw-mail-head">
      <span class="cw-mail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </span>
      <div>
        <h2 id="cw-mail-title">Email Us</h2>
        <p>Send us your enquiry and our team will get back to you shortly.</p>
      </div>
      <button type="button" class="cw-close" id="cw-mail-close" aria-label="Close the email enquiry form">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="cw-mail-form" novalidate>
      <div class="cw-field">
        <label for="cwm-name">Name <span aria-hidden="true">*</span></label>
        <input type="text" id="cwm-name" name="name" autocomplete="name" required maxlength="120" />
        <p class="cw-err" id="cwm-name-err" hidden></p>
      </div>
      <div class="cw-field">
        <label for="cwm-phone">Phone number <span aria-hidden="true">*</span></label>
        <div class="cw-phone">
          <label class="cw-visually-hidden" for="cwm-code">Country calling code</label>
          <select id="cwm-code" name="code">
            <option value="+966" selected>+966</option>
            <option value="+971">+971</option>
            <option value="+965">+965</option>
            <option value="+973">+973</option>
            <option value="+974">+974</option>
            <option value="+968">+968</option>
            <option value="+20">+20</option>
            <option value="+91">+91</option>
            <option value="+44">+44</option>
            <option value="+1">+1</option>
          </select>
          <input type="tel" id="cwm-phone" name="phone" autocomplete="tel-national" inputmode="tel" required maxlength="20" aria-describedby="cwm-code" />
        </div>
        <p class="cw-err" id="cwm-phone-err" hidden></p>
      </div>
      <div class="cw-field">
        <label for="cwm-email">Email <span aria-hidden="true">*</span></label>
        <input type="email" id="cwm-email" name="email" autocomplete="email" required maxlength="200" />
        <p class="cw-err" id="cwm-email-err" hidden></p>
      </div>
      <div class="cw-field">
        <label for="cwm-message">Message <span aria-hidden="true">*</span></label>
        <textarea id="cwm-message" name="message" rows="4" maxlength="1500"></textarea>
        <p class="cw-err" id="cwm-message-err" hidden></p>
      </div>
      <div id="cwm-status" role="status" hidden></div>
      <button type="submit" class="cw-submit" id="cwm-submit">
        Send Email
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </form>
  </div>
</div>

<style>
  .cw {
    position: fixed;
    right: 18px;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    z-index: 70;
    display: flex;
    align-items: flex-end;
    gap: 14px;
    pointer-events: none;
  }
  .cw-panel, .cw-rail, .cw-mail, .cw-backdrop { pointer-events: auto; }

  /* ----- rail ----- */
  .cw-rail { display: flex; flex-direction: column; gap: 12px; }
  .cw-item { position: relative; display: flex; justify-content: flex-end; }
  .cw-btn {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 150ms ease;
  }
  .cw-btn svg { width: 26px; height: 26px; }
  .cw-btn-phone { background: #b82020; }
  .cw-btn-wa { background: #25d366; }
  .cw-btn-mail { background: #fff; color: #b82020; border: 1px solid #e5e0dc; }
  @media (prefers-reduced-motion: no-preference) {
    .cw-btn:hover { transform: scale(1.06); }
  }
  .cw-btn:focus-visible { outline: 3px solid #b82020; outline-offset: 3px; }

  /* ----- flyouts ----- */
  .cw-fly {
    position: absolute;
    right: calc(100% + 10px);
    bottom: 0;
    display: none;
    flex-direction: column;
    min-width: 230px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    padding: 6px;
  }
  .cw-fly a, .cw-fly button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 11px 14px;
    border: none;
    border-radius: 8px;
    background: none;
    text-align: left;
    font: inherit;
    font-size: 0.9rem;
    color: #1f1a17;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .cw-fly a:hover, .cw-fly button:hover, .cw-fly a:focus-visible, .cw-fly button:focus-visible { background: #f6eeec; }
  .cw-fly .cw-fly-act {
    font-size: 0.72rem;
    font-weight: 700;
    color: #b82020;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .cw-fly a:focus-visible, .cw-fly button:focus-visible { outline: 2px solid #b82020; outline-offset: -2px; }
  .cw-item.open .cw-fly, .cw-item:focus-within .cw-fly { display: flex; }
  @media (hover: hover) {
    .cw-item:hover .cw-fly { display: flex; }
  }

  /* ----- panel ----- */
  .cw-panel {
    width: min(360px, calc(100vw - 120px));
    max-height: min(640px, calc(100dvh - 60px - env(safe-area-inset-bottom, 0px)));
    overflow-y: auto;
    background: #fff;
    border-radius: 18px;
    border-top: 4px solid #b82020;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.28);
    padding: 22px;
  }
  .cw-panel-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
  .cw-panel-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #b82020;
    color: #fff;
  }
  .cw-panel-icon svg { width: 20px; height: 20px; }
  .cw-panel h2 { margin: 0; font-size: 1.3rem; color: #1f1a17; }
  .cw-panel-head p { margin: 4px 0 0; font-size: 0.85rem; color: #6b625c; }
  .cw-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-left: auto;
    border: none;
    border-radius: 50%;
    background: #f6eeec;
    color: #b82020;
    cursor: pointer;
  }
  .cw-close svg { width: 16px; height: 16px; }
  .cw-close:focus-visible { outline: 2px solid #b82020; outline-offset: 2px; }

  .cw-field { margin-bottom: 12px; }
  .cw-field label { display: block; font-size: 0.8rem; font-weight: 600; color: #1f1a17; margin-bottom: 5px; }
  .cw-opt { font-weight: 400; color: #6b625c; }
  .cw-field input, .cw-field textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd6d1;
    border-radius: 10px;
    font: inherit;
    font-size: 0.92rem;
    color: #1f1a17;
    background: #fff;
    resize: vertical;
  }
  .cw-field input:focus, .cw-field textarea:focus { outline: 2px solid #b82020; outline-offset: 1px; border-color: #b82020; }
  .cw-field input[aria-invalid="true"] { border-color: #b82020; background: #fdf5f4; }
  .cw-err { margin: 5px 0 0; font-size: 0.78rem; color: #b82020; font-weight: 500; }
  .cw-phone { display: flex; gap: 8px; }
  .cw-phone select {
    flex: none;
    width: 92px;
    padding: 10px 8px;
    border: 1px solid #ddd6d1;
    border-radius: 10px;
    font: inherit;
    font-size: 0.92rem;
    color: #1f1a17;
    background: #faf7f5;
  }
  .cw-phone select:focus { outline: 2px solid #b82020; outline-offset: 1px; border-color: #b82020; }
  .cw-phone input { flex: 1; }
  .cw-visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  #cw-status { margin: 0 0 12px; padding: 10px 12px; border-radius: 10px; font-size: 0.82rem; }
  #cw-status.error { background: #fdf5f4; color: #8c1414; }
  #cw-status.info { background: #f2f6f2; color: #1d4d1d; }

  .cw-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 999px;
    background: #b82020;
    color: #fff;
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .cw-submit svg { width: 18px; height: 18px; }
  .cw-submit:hover { background: #9c1a1a; }
  .cw-submit:focus-visible { outline: 3px solid #1f1a17; outline-offset: 2px; }
  .cw-submit[disabled] { opacity: 0.6; cursor: default; }

  /* ----- email enquiry sheet ----- */
  .cw-backdrop {
    position: fixed;
    inset: 0;
    z-index: 65;
    background: rgba(31, 26, 23, 0.45);
  }
  .cw-mail {
    position: fixed;
    z-index: 71;
    background: #fff;
    border-radius: 18px;
    border-top: 4px solid #b82020;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.28);
    padding: 22px;
    width: min(360px, calc(100vw - 110px));
    max-height: min(600px, calc(100dvh - 80px));
    overflow-y: auto;
    right: 18px;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
  }
  .cw-mail-grip { display: none; }
  .cw-mail-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
  .cw-mail-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #b82020;
    color: #fff;
  }
  .cw-mail-icon svg { width: 20px; height: 20px; }
  .cw-mail h2 { margin: 0; font-size: 1.3rem; color: #1f1a17; }
  .cw-mail-head p { margin: 4px 0 0; font-size: 0.85rem; color: #6b625c; }
  @media (prefers-reduced-motion: no-preference) {
    .cw-backdrop { animation: cw-fade 200ms ease; }
    .cw-mail { animation: cw-slide-up 240ms cubic-bezier(0.22, 1, 0.36, 1); }
    @keyframes cw-fade { from { opacity: 0; } }
    @keyframes cw-slide-up { from { transform: translateY(40px); opacity: 0; } }
  }

  /* mobile: full-width bottom sheet */
  @media (max-width: 620px) {
    .cw-backdrop[hidden] { display: none; }
    .cw-mail {
      right: 0;
      left: 0;
      bottom: 0;
      width: 100%;
      max-height: calc(100dvh - 90px);
      border-radius: 20px 20px 0 0;
      border-top-width: 3px;
      padding: 14px 20px calc(18px + env(safe-area-inset-bottom, 0px));
    }
    .cw-mail-grip {
      display: block;
      width: 44px;
      height: 4px;
      border-radius: 999px;
      background: #ddd6d1;
      margin: 0 auto 12px;
    }
  }

  @media (max-width: 620px) {
    .cw { right: 6px; bottom: calc(8px + env(safe-area-inset-bottom, 0px)); gap: 8px; }
    .cw-btn { width: 44px; height: 44px; }
    .cw-btn svg { width: 20px; height: 20px; }
    .cw-panel {
      width: min(340px, calc(100vw - 86px));
      max-height: calc(100dvh - 120px - env(safe-area-inset-bottom, 0px));
      padding: 18px;
    }
    .cw-fly { min-width: 200px; }
  }
</style>

<script>
  import { sendEnquiry, COMPANY_EMAIL } from '../scripts/enquiry';

  const widget = document.getElementById('contact-widget')!;
  const panel = document.getElementById('cw-panel')!;
  const closeBtn = document.getElementById('cw-close')!;
  const items = [...widget.querySelectorAll<HTMLElement>('.cw-item')];

  function setOpen(item: HTMLElement, open: boolean) {
    item.classList.toggle('open', open);
    const btn = item.querySelector('button')!;
    btn.setAttribute('aria-expanded', String(open));
  }
  function closeAllFlyouts(except?: HTMLElement) {
    items.forEach((it) => { if (it !== except) setOpen(it, false); });
  }

  // tap-to-reveal flyouts (hover is handled by CSS :focus-within / .open on
  // hover-capable pointers via :hover rules below); clicking the rail button
  // performs the primary action on desktop pointers.
  const canHover = matchMedia('(hover: hover)').matches;

  const waBtn = document.getElementById('cw-wa-btn')!;
  const mailBtn = document.getElementById('cw-mail-btn')!;
  const phoneBtn = document.getElementById('cw-phone-btn')!;

  function openPanel() {
    closeAllFlyouts();
    panel.hidden = false;
    closeBtn.focus();
  }
  function closePanel() {
    panel.hidden = true;
    phoneBtn.focus();
  }

  phoneBtn.addEventListener('click', () => {
    if (canHover) { openPanel(); return; }
    // touch: first tap reveals, phone links/call-back entry are in the flyout
    const open = !phoneBtn.closest('.cw-item')!.classList.contains('open');
    closeAllFlyouts();
    setOpen(phoneBtn.closest('.cw-item') as HTMLElement, open);
  });
  document.getElementById('cw-callback')!.addEventListener('click', openPanel);

  waBtn.addEventListener('click', () => {
    const item = waBtn.closest('.cw-item') as HTMLElement;
    if (canHover) { window.open('https://wa.me/966580208504', '_blank', 'noopener'); return; }
    const open = !item.classList.contains('open');
    closeAllFlyouts();
    setOpen(item, open);
  });

  mailBtn.addEventListener('click', () => {
    openMailSheet();
  });

  // ----- email enquiry sheet -----
  const mailPanel = document.getElementById('cw-mail-panel')!;
  const mailBackdrop = document.getElementById('cw-mail-backdrop')!;
  const mailClose = document.getElementById('cw-mail-close')!;
  const mailForm = document.getElementById('cw-mail-form') as HTMLFormElement;
  const mailStatus = document.getElementById('cwm-status')!;
  const mailSubmitBtn = document.getElementById('cwm-submit') as HTMLButtonElement;
  const mailFields = {
    name: document.getElementById('cwm-name') as HTMLInputElement,
    phone: document.getElementById('cwm-phone') as HTMLInputElement,
    email: document.getElementById('cwm-email') as HTMLInputElement,
    message: document.getElementById('cwm-message') as HTMLTextAreaElement,
  };
  const CWM_PHONE_RE = /^[+\d ()\-.]{6,20}$/;

  function openMailSheet() {
    closeAllFlyouts();
    mailBackdrop.hidden = false;
    mailPanel.hidden = false;
    mailBtn.setAttribute('aria-expanded', 'true');
    mailClose.focus();
  }
  function closeMailSheet() {
    mailBackdrop.hidden = true;
    mailPanel.hidden = true;
    mailBtn.setAttribute('aria-expanded', 'false');
    mailBtn.focus();
  }
  mailClose.addEventListener('click', closeMailSheet);
  // outside tap closes only when nothing has been typed, so entered data is
  // never discarded without warning
  mailBackdrop.addEventListener('click', () => {
    const hasInput = Object.values(mailFields).some((f) => f.value.trim());
    if (!hasInput) closeMailSheet();
  });

  function validateMail(id: keyof typeof mailFields): string {
    const v = mailFields[id].value.trim();
    if (!v) return 'This field is required.';
    if (id === 'email' && !EMAIL_RE.test(v)) return 'Enter a valid email address.';
    if (id === 'phone' && !CWM_PHONE_RE.test(v)) return 'Enter a valid phone number (digits, spaces, + ( ) - only).';
    return '';
  }
  function showMailError(id: keyof typeof mailFields, msg: string) {
    const input = mailFields[id];
    const errEl = document.getElementById(`cwm-${id}-err`);
    if (!errEl) return;
    if (msg) {
      input.setAttribute('aria-invalid', 'true');
      errEl.textContent = msg;
      errEl.hidden = false;
    } else {
      input.removeAttribute('aria-invalid');
      errEl.hidden = true;
    }
  }

  let lastMailSubmit = 0;
  mailForm.addEventListener('submit', (e) => {
    e.preventDefault();
    mailStatus.hidden = true;
    let firstBad: HTMLElement | null = null;
    (Object.keys(mailFields) as (keyof typeof mailFields)[]).forEach((id) => {
      const msg = validateMail(id);
      showMailError(id, msg);
      if (msg && !firstBad) firstBad = mailFields[id];
    });
    if (firstBad) { (firstBad as HTMLElement).focus(); return; }

    // duplicate-submission guard: ignore double fires within 5 seconds
    const now = Date.now();
    if (now - lastMailSubmit < 5000) return;
    lastMailSubmit = now;

    mailSubmitBtn.disabled = true;
    const fullPhone = `${(document.getElementById('cwm-code') as HTMLSelectElement).value} ${mailFields.phone.value.trim()}`;
    const result = sendEnquiry('Website email enquiry', [
      `Name: ${mailFields.name.value.trim()}`,
      `Phone: ${fullPhone}`,
      `Email: ${mailFields.email.value.trim()}`,
      '',
      mailFields.message.value.trim(),
      '',
      'Sent from the "Email Us" contact widget.',
    ]);
    mailSubmitBtn.disabled = false;

    if (result.kind === 'mailto') {
      mailStatus.textContent = 'Validation passed. Your email application should now open with the enquiry pre-filled — please press send there. This website cannot confirm whether the email was actually sent.';
      mailStatus.className = 'info';
    } else {
      mailStatus.textContent = `Your enquiry is too long for an automatic email draft. Please email ${COMPANY_EMAIL} directly with the details above.`;
      mailStatus.className = 'error';
    }
    mailStatus.hidden = false;
  });

  (Object.keys(mailFields) as (keyof typeof mailFields)[]).forEach((id) => {
    mailFields[id].addEventListener('input', () => {
      if (mailFields[id].getAttribute('aria-invalid') === 'true') showMailError(id, validateMail(id));
    });
  });

  // close flyouts when clicking elsewhere or pressing Escape
  document.addEventListener('click', (e) => {
    if (!widget.contains(e.target as Node)) closeAllFlyouts();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!mailPanel.hidden) closeMailSheet();
    else if (!panel.hidden) closePanel();
    else closeAllFlyouts();
  });
  closeBtn.addEventListener('click', closePanel);

  // ----- callback form -----
  const form = document.getElementById('cw-form') as HTMLFormElement;
  const status = document.getElementById('cw-status')!;
  const submitBtn = document.getElementById('cw-submit') as HTMLButtonElement;
  const fields = {
    name: document.getElementById('cw-name') as HTMLInputElement,
    phone: document.getElementById('cw-phone') as HTMLInputElement,
    email: document.getElementById('cw-email') as HTMLInputElement,
    message: document.getElementById('cw-message') as HTMLTextAreaElement,
  };
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const PHONE_RE = /^[+\d ()\-.]{6,30}$/;

  function validate(id: keyof typeof fields): string {
    const v = fields[id].value.trim();
    if (id !== 'message' && !v) return 'This field is required.';
    if (id === 'email' && v && !EMAIL_RE.test(v)) return 'Enter a valid email address.';
    if (id === 'phone' && v && !PHONE_RE.test(v)) return 'Enter a valid phone number (digits, spaces, + ( ) - only).';
    return '';
  }
  function showError(id: keyof typeof fields, msg: string) {
    const input = fields[id];
    const errEl = document.getElementById(`cw-${id}-err`);
    if (msg && errEl) {
      input.setAttribute('aria-invalid', 'true');
      errEl.textContent = msg;
      errEl.hidden = false;
    } else if (errEl) {
      input.removeAttribute('aria-invalid');
      errEl.hidden = true;
    }
  }

  let lastSubmit = 0;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    status.hidden = true;
    let firstBad: HTMLInputElement | null = null;
    (Object.keys(fields) as (keyof typeof fields)[]).forEach((id) => {
      const msg = validate(id);
      showError(id, msg);
      if (msg && !firstBad) firstBad = fields[id];
    });
    if (firstBad) { (firstBad as HTMLInputElement).focus(); return; }

    // duplicate-submission guard: ignore double fires within 5 seconds
    const now = Date.now();
    if (now - lastSubmit < 5000) return;
    lastSubmit = now;

    submitBtn.disabled = true;
    const result = sendEnquiry('Call back request', [
      `Name: ${fields.name.value.trim()}`,
      `Phone: ${fields.phone.value.trim()}`,
      `Email: ${fields.email.value.trim()}`,
      fields.message.value.trim() && `Message: ${fields.message.value.trim()}`,
      '',
      'Sent from the "Get a Call Back" widget.',
    ]);
    submitBtn.disabled = false;

    if (result.kind === 'mailto') {
      status.textContent = 'Validation passed. Your email application should now open with the request pre-filled — please press send there. This website cannot confirm whether the email was actually sent.';
      status.className = 'info';
    } else {
      status.textContent = `Your request is too long for an automatic email draft. Please email ${COMPANY_EMAIL} directly with the details above.`;
      status.className = 'error';
    }
    status.hidden = false;
  });

  // live re-validation
  (Object.keys(fields) as (keyof typeof fields)[]).forEach((id) => {
    fields[id].addEventListener('input', () => {
      if (fields[id].getAttribute('aria-invalid') === 'true') showError(id, validate(id));
    });
  });
</script>
