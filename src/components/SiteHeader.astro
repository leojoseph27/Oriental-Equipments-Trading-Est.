---
// SiteHeader — sticky header, logo, anchor nav, accessible mobile drawer.
// In-page anchors are homepage-scoped (/#brands) so they work from every route.
const nav = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products/' },
  { label: 'Catalogue', href: '/catalogue/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Search', href: '/search/' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Oriental Equipments Trading Est. — home">
      <img src="/images/logo/oriental-logo.png" alt="Oriental Equipments Trading Est. logo" width="44" height="44" />
      <span class="brand-name">Oriental Equipments<br />Trading Est.</span>
    </a>
    <nav class="desktop-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <a class="cta" href="/contact/">Request a Quote</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
    {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>)}
    <a class="cta" href="/contact/">Request a Quote</a>
  </nav>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper-card);
    border-bottom: var(--line-weight) solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: var(--space-5); min-height: 64px; }
  .brand { display: flex; align-items: center; gap: var(--space-3); margin-right: auto;
    text-decoration: none; color: var(--ink); }
  .brand img { width: 44px; height: 44px; object-fit: contain; }
  .brand-name { font-family: var(--font-heading); font-weight: 600; font-size: 15px;
    line-height: 1.15; letter-spacing: 0.02em; text-transform: uppercase; }
  .desktop-nav { display: flex; gap: var(--space-5); }
  .desktop-nav a { color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 500;
    padding: var(--space-2) 0; border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard); }
  .desktop-nav a:hover { border-bottom-color: var(--red-brand); color: var(--red-deep); }
  .desktop-nav a[aria-current="page"] { border-bottom-color: var(--red-brand); color: var(--red-deep); }
  .cta {
    display: inline-block; background: var(--red-brand); color: #fff; text-decoration: none;
    font-weight: 600; font-size: 15px; padding: 10px 18px; border-radius: var(--radius);
    transition: background-color var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
  }
  .cta:hover { background: var(--red-deep); color: #fff; }
  .menu-btn { display: none; background: none; border: var(--line-weight) solid var(--line);
    border-radius: var(--radius); padding: 10px 14px; font: inherit; font-weight: 600; color: var(--ink); cursor: pointer; }
  .mobile-nav { display: none; }
  @media (max-width: 900px) {
    .desktop-nav, .bar > .cta { display: none; }
    .menu-btn { display: block; }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav { display: flex; flex-direction: column; border-top: var(--line-weight) solid var(--line);
      padding: var(--space-4) 24px var(--space-5); background: var(--paper-card);
      animation: menu-drop var(--dur-med) var(--ease-out); }
    @keyframes menu-drop {
      from { opacity: 0; transform: translateY(calc(-1 * var(--dist-1))); }
      to { opacity: 1; transform: none; }
    }
    .mobile-nav a { color: var(--ink); text-decoration: none; padding: var(--space-3) 0;
      font-size: 17px; border-bottom: var(--line-weight) solid var(--line); }
    .mobile-nav a[aria-current="page"] { color: var(--red-deep); font-weight: 600; }
    .mobile-nav a.cta { margin-top: var(--space-4); border-bottom: none; text-align: center; }
  }
</style>
<script>
  const btn = document.querySelector('.menu-btn');
  const panel = document.getElementById('mobile-nav');

  function setMenu(open: boolean) {
    if (!panel || !btn) return;
    panel.toggleAttribute('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
  }

  btn?.addEventListener('click', () => {
    setMenu(panel?.hasAttribute('hidden') ?? false);
  });

  // Escape closes the drawer and returns focus to the toggle.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hasAttribute('hidden')) {
      setMenu(false);
      btn?.focus();
    }
  });

  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') setMenu(false);
  });
</script>
