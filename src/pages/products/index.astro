---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories, products } from "../../data/catalog";
const count = (n: number) => products.filter((p) => p.categoryId === n).length;
---
<BaseLayout
  title="Product Catalogue — Oriental Equipments Trading Est."
  description="Browse 20 categories of welding electrodes, wires, torches, gas equipment, machines, abrasives, chemicals and safety gear — 190 catalogue items from Oriental Equipments Trading Est., Dammam."
>
  <SiteHeader />
  <main id="main" tabindex="-1" class="container section">
    <Breadcrumbs trail={[{ label: "Home", href: "/" }, { label: "Products" }]} />
    <h1>Product Catalogue</h1>
    <p class="intro">
      Twenty product categories covering welding consumables, torches and torch
      accessories, gas equipment, machines, abrasives, chemicals and safety gear —
      {products.length} catalogue items. Select a category to see its products with
      AWS classifications, model numbers and sizes as printed in the company catalogue.
    </p>

    <form class="searchbar" action="/search" method="get" role="search">
      <label class="spec" for="q">Search the catalogue</label>
      <div class="row">
        <input id="q" name="q" type="search" placeholder="e.g. E7018, 24KD, gouging rod…" autocomplete="off" />
        <button type="submit">Search</button>
      </div>
    </form>

    <h2 class="visually-hidden">Categories</h2>
    <ol class="grid" data-reveal-group>
      {categories.map((c) => (
        <li>
          <a class="tile" href={`/products/${c.slug}/`}>
            <span class="no" aria-hidden="true">{String(c.indexNo).padStart(2, "0")}</span>
            <span class="name">{c.name}</span>
            <span class="meta">{count(c.indexNo)} items</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  h1 { color: var(--red-deep); text-transform: uppercase; }
  .intro { color: var(--ink-secondary); max-width: 70ch; }
  .searchbar { margin: var(--space-6) 0 var(--space-8); max-width: 560px; }
  .searchbar label { display: block; margin-bottom: var(--space-2); }
  .row { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  input { flex: 1 1 160px; min-width: 0; font: inherit; padding: 10px 12px; border: var(--line-weight) solid var(--line);
    background: var(--paper-card); color: var(--ink); border-radius: var(--radius);
    transition: border-color var(--dur-fast) var(--ease-standard); }
  input:hover { border-color: var(--ink-tertiary); }
  input:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  button { font: inherit; font-weight: 600; background: var(--red-brand); color: #fff;
    border: none; border-radius: var(--radius); padding: 10px 20px; cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-standard); }
  button:hover { background: var(--red-deep); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
  .tile { display: flex; flex-direction: column; gap: var(--space-2); height: 100%;
    background: var(--paper-card); border: var(--line-weight) solid var(--line);
    padding: var(--space-4); text-decoration: none; color: var(--ink);
    transition: border-color 120ms ease; }
  .tile:hover { border-color: var(--ink); }
  .tile:hover .name { color: var(--red-deep); }
  .no { font-family: var(--font-heading); font-weight: 600; font-size: 26px;
    color: var(--green-brand); line-height: 1; }
  .name { font-family: var(--font-heading); font-weight: 600; font-size: 19px;
    line-height: 1.15; text-transform: uppercase; }
  .meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-tertiary);
    margin-top: auto; }
  .visually-hidden { position: absolute; left: -9999px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .grid { grid-template-columns: 1fr; } }
</style>
